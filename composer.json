{
  "name": "owebstudio/kirby-accordion-field",
  "description": "Collapses the content below headlines in Panel for Kirby 4.",
  "type": "kirby-plugin",
  "version": "2.0.0",
  "license": "proprietary",
  "keywords": [
    "kirby",
    "kirby-4",
    "kirby4-plugin",
    "kirby-plugin",
    "owebstudio-plugin",
    "kirby-accordion"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "contact@owebstudio.com"
  },
  "authors": [
    {
      "name": "Oweb Studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "require": {
    "php": "^8.1",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "kirby-accordion-field"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
