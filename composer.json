{
  "name": "owebstudio/kirby-accordion-field",
  "description": "Collapses the content below headlines in Panel for Kirby.",
  "type": "kirby-plugin",
  "version": "3.2.0",
  "license": "MIT",
  "keywords": [
    "kirby",
    "kirby-plugin",
    "kirby5",
    "owebstudio-plugin",
    "kirby-accordion"
  ],
  "homepage": "https://github.com/owebstudio/kirby-accordion-field",
  "support": {
    "email": "contact@owebstudio.com"
  },
  "authors": [
    {
      "name": "Oweb Studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    }
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "kirby-accordion-field",
    "kirby": {
      "compatible": "^5.0"
    }
  },
  "prefer-stable": true
}
